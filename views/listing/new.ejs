<% layout('/layouts/boilerplate') -%>
<body>
     <div class="row mt-3">
    <div class="col-md-8 offset-md-2">
      <h3> Create a new Listing </h3>
     <form method="post" 
           action="/listings" 
           class="needs-validation" 
           novalidate 
           enctype="multipart/form-data">
       <div class="mb-3">
           <label for="title" class="form-label">Title : </label>
           <input type="text" class="form-control" id="title" name="listing[title]" pattern="^(?=.{5,}$)[A-Za-z]+(?: [A-Za-z]+)*$"" minlength='5' placeholder="Add a catcy title" required>
           <div class="valid-feedback"> Title is right</div>
           <div class="invalid-feedback">Title only have albhabet and space and minimum 5 character</div>
       </div>
       
       <div class="mb-3">
          <label for="desc" class="form-label">description : </label>
          <textarea type="text" class="form-control" id="desc" name="listing[description]" minlength='5' required></textarea>
          <div class="valid-feedback"> description is right </div>
          <div class="invalid-feedback"> description length should be greater then 5</div>
       </div>
        
       <div class="mb-3">
          <label for="image" class="form-label">image Url : </label>
          <input type="file" class="form-control" id="image" name="listing[image]" required>
          <div class="valid-feedback"> image is right </div>
          <div class="invalid-feedback"> image should be valid </div>
       </div> 
       
       <div class="row">
         <div class="mb-3 col-md-6">
           <label for="price" class="form-label">Price : </label>
           <input type="number" class="form-control" id="price" name="listing[price]"  min="0" placeholder="1200" required>
           <div class="valid-feedback"> Price is right </div>
           <div class="invalid-feedback"> Price should be valid </div>
         </div>
       
         <div class="mb-3 col-md-6">
           <label for="country" class="form-label">Country : </label>
           <input type="text" class="form-control" id="country" name="listing[country]" pattern="^(?=.{3,}$)[A-Za-z]+(?: [A-Za-z]+)*$" placeholder="india" minlength='3' required>
           <div class="valid-feedback"> Country name is right </div>
           <div class="invalid-feedback">Country only have albhabet and minimum 3 character</div>
         </div>
       </div>

       <div class="row">
        <div class="mb-3 col-md-6">
          <label for="location" class="form-label">location : </label>
          <input type="text" class="form-control" id="location" name="listing[location]" pattern="^(?=.{3,}$)[A-Za-z]+(?: [A-Za-z]+)*$" placeholder="indore,Madhya pradesh" minlength='3'  required>
          <div class="valid-feedback"> location name is right </div>
          <div class="invalid-feedback">location only have albhabet and minimum 3 character</div>
        </div>

        <div class="mb-3 col-md-6">
         <label for="category" class="form-label">Category : </label>
         <select class="form-select" name="listing[category]" required>
          <option value="" disabled selected>select Category</option>
          <option value="trandings">Trandings</option>
          <option value="mountains">Moutains</option>
          <option value="amazing pools">Amazing Pools</option>
          <option value="iconic cities">Iconic Cities</option>
          <option value="rooms">Rooms</option>
          <option value="camping">Camping</option>
          <option value="farms">Farms</option>
          <option value="arctic">Arctic</option>
          <option value="casties">Casties</option>
          <option value="boating house">Boating House</option>
         </select>
         <div class="valid-feedback">Category selected </div>
         <div class="invalid-feedback">Category selection is required</div>
       </div>
      </div>
       <button class="btn btn-dark add-btn mt-2 mb-3" > Add </button>
     </form>
      </div>
   </div>   
</body>
